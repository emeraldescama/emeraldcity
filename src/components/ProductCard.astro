---
import WhatsAppButton from './WhatsAppButton.astro';
import { getBazarWhatsAppUrl } from '../utils/whatsapp';

interface Props {
  name: string;
  category: 'Miniaturas' | 'Útiles' | 'Cosplay/Accesorios';
  description: string;
  material: string;
  dimensions: string;
  image: string;
  available?: boolean;
}

const {
  name,
  category,
  description,
  material,
  dimensions,
  image,
  available = true,
} = Astro.props;

const whatsappUrl = getBazarWhatsAppUrl(name);
---

<div class="glass-card rounded-2xl overflow-hidden flex flex-col group h-full border border-emerald-500/20 hover:border-emerald-400/50" data-category={category}>
  <!-- Image Container -->
  <div class="relative aspect-square overflow-hidden bg-zinc-900/90">
    <img
      src={image}
      alt={name}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>

    <!-- Category Tag -->
    <div class="absolute top-3.5 left-3.5">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-zinc-950/80 border border-emerald-500/30 text-emerald-300 backdrop-blur-md">
        {category}
      </span>
    </div>

    <!-- Status Badge -->
    <div class="absolute top-3.5 right-3.5">
      {available ? (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 backdrop-blur-md">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Disponible
        </span>
      ) : (
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-zinc-800 text-zinc-400 border border-zinc-700">
          Bajo Pedido
        </span>
      )}
    </div>
  </div>

  <!-- Content & Specs -->
  <div class="p-6 flex-grow flex flex-col justify-between">
    <div>
      <h3 class="text-lg sm:text-xl font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors leading-snug">
        {name}
      </h3>
      <p class="text-zinc-400 text-sm mt-2.5 leading-relaxed">
        {description}
      </p>

      <!-- Specifications Grid -->
      <div class="mt-4 pt-4 border-t border-zinc-800/80 space-y-2 text-xs">
        <div class="flex items-center justify-between text-zinc-300">
          <span class="text-zinc-400 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="8" rx="2" />
              <rect x="2" y="14" width="20" height="8" rx="2" />
            </svg>
            Material:
          </span>
          <span class="font-medium text-right text-zinc-200">{material}</span>
        </div>
        <div class="flex items-center justify-between text-zinc-300">
          <span class="text-zinc-400 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="4 7 4 4 20 4 20 7" />
              <line x1="9" y1="20" x2="15" y2="20" />
              <line x1="12" y1="4" x2="12" y2="20" />
            </svg>
            Dimensiones:
          </span>
          <span class="font-medium text-right text-zinc-200">{dimensions}</span>
        </div>
      </div>
    </div>

    <!-- WhatsApp CTA Button -->
    <div class="mt-6 pt-2">
      <WhatsAppButton
        href={whatsappUrl}
        label="Cotizar por WhatsApp"
        variant="primary"
        size="md"
        fullWidth={true}
      />
    </div>
  </div>
</div>
