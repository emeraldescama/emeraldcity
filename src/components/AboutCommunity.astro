---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import WhatsAppButton from './WhatsAppButton.astro';
import { getGeneralContactWhatsAppUrl } from '../utils/whatsapp';

// Foto grupal de la comunidad: basta con guardarla en esta ruta para que aparezca
const PHOTO = '/images/comunidad/foto-grupal.jpg';
const hasPhoto = existsSync(join(process.cwd(), 'public', PHOTO));

const infoUrl = getGeneralContactWhatsAppUrl();
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24" id="que-es-emerald-city">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
    <!-- Foto -->
    <div class="relative">
      <div class="absolute -inset-3 bg-emerald-500/10 rounded-3xl blur-2xl pointer-events-none"></div>
      {hasPhoto ? (
        <img
          src={PHOTO}
          alt="Entrenadores de Emerald City reunidos en el Pokémon GO Fest 2026"
          loading="lazy"
          class="relative w-full aspect-[4/3] object-cover rounded-3xl border border-emerald-500/30 shadow-emerald-glow-lg"
        />
      ) : (
        <div class="relative w-full aspect-[4/3] rounded-3xl border border-emerald-500/30 shadow-emerald-glow-lg bg-gradient-to-br from-emerald-950 via-zinc-950 to-zinc-900 flex items-center justify-center">
          <img src="/images/branding/logo-emerald-city.png" alt="Emerald City" class="w-1/3 drop-shadow-2xl" />
        </div>
      )}
    </div>

    <!-- Descripción -->
    <div class="space-y-5">
      <h2 class="text-xs font-bold tracking-widest text-amber-400 uppercase">Nuestra comunidad</h2>
      <p class="text-3xl sm:text-4xl font-black text-zinc-100 tracking-tight">¿Qué es Emerald City?</p>
      <p class="text-base text-zinc-300 leading-relaxed">
        Emerald City es la comunidad de entrenadores de <strong class="text-emerald-400">Pokémon GO en Caracas</strong>. Nos une algo simple: el juego es mejor en grupo.
      </p>
      <p class="text-base text-zinc-300 leading-relaxed">
        Cada Día de la Comunidad nos encontramos en el <strong class="text-zinc-100">Parque del Este</strong>, armamos equipos para los días de incursiones en la <strong class="text-zinc-100">Plaza Los Palos Grandes</strong> y vivimos juntos los GO Tour, GO Fest y Wild Area. Aquí caben todos los equipos y todos los niveles: desde quien acaba de empezar hasta quien busca su próximo Hundo.
      </p>
      <p class="text-base text-zinc-300 leading-relaxed">
        Inspirados en Rayquaza, el guardián de los cielos, compartimos intercambios, consejos, incursiones y sobre todo amistad.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <a
          href="/unirse"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-bold text-zinc-950 bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400 rounded-xl shadow-emerald-glow transition-all"
        >
          Quiero ser parte de la comunidad
        </a>
        <WhatsAppButton href={infoUrl} label="Más información" variant="secondary" size="md" />
      </div>
    </div>
  </div>
</section>
