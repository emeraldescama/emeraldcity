---
import EventCard from './EventCard.astro';
import { caracasToday, flyerWeek, formatWeekRange, type Evento } from '../utils/eventos';

interface Props {
  eventos: Evento[];
}

const { eventos } = Astro.props;

// Ubicación inicial calculada al compilar; el script la corrige con la fecha real del visitante.
// Los domingos la sección principal ya muestra la semana que empieza el lunes.
const today = caracasToday();
const week = flyerWeek(today);
const upcoming = eventos.filter((e) => e.date >= today);
const thisWeek = upcoming.filter((e) => e.date <= week.end);
const later = upcoming.filter((e) => e.date > week.end);
---

<section class="mb-20" id="eventos">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-8">
    <div>
      <h2 class="text-xs font-bold tracking-widest text-amber-400 uppercase">Agenda Emerald</h2>
      <p id="eventos-semana-titulo" class="text-3xl sm:text-4xl font-black text-zinc-100 tracking-tight mt-1">
        {week.isNext ? 'Eventos de la próxima semana' : 'Eventos de esta semana'}
      </p>
    </div>
    <div class="flex flex-col sm:items-end gap-3">
      <p id="eventos-semana-rango" class="text-sm font-semibold text-zinc-400">
        {formatWeekRange(week.start, week.end)}
      </p>
      <button
        id="descargar-semana"
        type="button"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-950 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 rounded-xl shadow-amber-glow transition-all disabled:opacity-60"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span>Descargar imagen de la semana</span>
      </button>
    </div>
  </div>

  <!-- Invitación a unirse -->
  <div class="mb-8 p-5 sm:p-6 rounded-2xl border border-amber-500/40 bg-gradient-to-r from-amber-500/15 via-emerald-500/10 to-transparent flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <p class="text-lg sm:text-xl font-black text-zinc-100 tracking-tight">¿Juegas Pokémon GO en Caracas?</p>
      <p class="text-sm text-zinc-300 mt-1">Regístrate en minutos y te sumamos a las quedadas, incursiones y Días de la Comunidad.</p>
    </div>
    <a
      href="/unirse"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-black uppercase tracking-wider text-zinc-950 bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400 rounded-xl shadow-emerald-glow-lg transition-all hover:scale-[1.02] whitespace-nowrap"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
      Quiero ser parte de la comunidad
    </a>
  </div>

  <div id="eventos-semana" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {thisWeek.map((evento) => <EventCard evento={evento} />)}
  </div>

  <div
    id="eventos-semana-vacio"
    class:list={['text-center py-14 px-6 glass-card rounded-2xl border border-zinc-800', { hidden: thisWeek.length > 0 }]}
  >
    <p class="text-zinc-300 text-base font-semibold">Todavía no hay eventos publicados para esta semana.</p>
    <p class="text-zinc-400 text-sm mt-2">Únete al grupo de WhatsApp para enterarte primero de las próximas quedadas.</p>
  </div>

  <div id="eventos-proximos-bloque" class:list={['mt-16', { hidden: later.length === 0 }]}>
    <h3 class="text-2xl font-black text-zinc-100 tracking-tight mb-8">Próximamente</h3>
    <div id="eventos-proximos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {later.map((evento) => <EventCard evento={evento} />)}
    </div>
  </div>
</section>

<script>
  import { caracasToday, flyerWeek, formatWeekRange, type Evento } from '../utils/eventos';
  import { drawWeeklyFlyer } from '../scripts/weeklyFlyer';

  // Reubica cada evento según la semana actual del visitante (la página solo se recompila al publicar)
  function placeEvents() {
    const thisWeekGrid = document.getElementById('eventos-semana');
    const laterGrid = document.getElementById('eventos-proximos');
    if (!thisWeekGrid || !laterGrid) return;

    const today = caracasToday();
    const week = flyerWeek(today);
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.evento-card'))
      .sort((a, b) => Number(a.dataset.start) - Number(b.dataset.start));

    for (const card of cards) {
      const date = card.dataset.date ?? '';
      if (date < today) card.remove();
      else if (date <= week.end) thisWeekGrid.appendChild(card);
      else laterGrid.appendChild(card);
    }

    const title = document.getElementById('eventos-semana-titulo');
    if (title) title.textContent = week.isNext ? 'Eventos de la próxima semana' : 'Eventos de esta semana';
    const range = document.getElementById('eventos-semana-rango');
    if (range) range.textContent = formatWeekRange(week.start, week.end);
    document.getElementById('eventos-semana-vacio')?.classList.toggle('hidden', thisWeekGrid.children.length > 0);
    document.getElementById('eventos-proximos-bloque')?.classList.toggle('hidden', laterGrid.children.length === 0);
  }

  /** Arma en una sola imagen los eventos de la semana y la descarga (o la comparte en el celular) */
  async function downloadWeek(button: HTMLButtonElement) {
    // Los domingos se comparte la semana que empieza el lunes siguiente
    const week = flyerWeek(caracasToday());
    const eventos = allEventos.filter((evento) => evento.date >= week.start && evento.date <= week.end);
    button.disabled = true;
    try {
      const canvas = document.createElement('canvas');
      await drawWeeklyFlyer(canvas, eventos, week.start, week.end, {
        logoUrl: '/images/branding/logo-emerald-city.png',
        flyerUrl: (evento) => evento.flyer,
      });
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
      if (!blob) return;
      const file = new File([blob], `eventos-emerald-city-${week.start}.png`, { type: 'image/png' });

      if (navigator.canShare?.({ files: [file] }) && matchMedia('(pointer: coarse)').matches) {
        await navigator.share({ files: [file] }).catch(() => undefined);
        return;
      }
      const url = URL.createObjectURL(file);
      const link = document.createElement('a');
      link.href = url;
      link.download = file.name;
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    } finally {
      button.disabled = false;
    }
  }

  // Se leen antes de placeEvents, que quita de la página los eventos ya pasados (el flyer incluye toda la semana)
  const allEventos: Evento[] = Array.from(document.querySelectorAll<HTMLElement>('.evento-card'))
    .map((card) => JSON.parse(card.dataset.evento ?? '{}') as Evento)
    .sort((a, b) => `${a.date}${a.time}`.localeCompare(`${b.date}${b.time}`));
  placeEvents();
  const downloadButton = document.getElementById('descargar-semana') as HTMLButtonElement | null;
  downloadButton?.addEventListener('click', () => downloadWeek(downloadButton));
</script>
