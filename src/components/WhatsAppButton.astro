---
interface Props {
  href: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'amber';
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  class?: string;
}

const {
  href,
  label = "Contactar por WhatsApp",
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'px-3.5 py-1.5 text-xs',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3.5 text-base',
}[size];

const variantClasses = {
  primary: 'bg-gradient-to-r from-emerald-500 to-emerald-400 text-zinc-950 font-bold hover:from-emerald-400 hover:to-emerald-300 shadow-emerald-glow hover:shadow-emerald-glow-lg border border-emerald-300/40',
  secondary: 'bg-zinc-900/90 text-emerald-400 font-semibold hover:bg-zinc-800 border border-emerald-500/30 hover:border-emerald-400/60',
  outline: 'bg-transparent text-zinc-200 font-semibold hover:text-emerald-400 border border-zinc-700 hover:border-emerald-400/50',
  amber: 'bg-gradient-to-r from-amber-400 to-amber-500 text-zinc-950 font-bold hover:from-amber-300 hover:to-amber-400 shadow-amber-glow border border-amber-200/50',
}[variant];
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center justify-center gap-2.5 rounded-xl transition-all duration-300 transform active:scale-95 group ${sizeClasses} ${variantClasses} ${fullWidth ? 'w-full' : ''} ${className}`}
>
  <!-- WhatsApp Icon SVG -->
  <svg class="w-4 h-4 flex-shrink-0 fill-current transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24">
    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zM17.48 16.71c-.24.68-1.2 1.25-1.97 1.34-.52.06-1.2.09-3.48-.86-2.93-1.21-4.81-4.22-4.96-4.42-.15-.2-1.19-1.58-1.19-3.02 0-1.44.75-2.15 1.02-2.44.27-.29.59-.36.79-.36.2 0 .4 0 .58.01.19.01.44-.07.69.53.25.61.86 2.11.94 2.26.08.15.13.33.03.53-.1.2-.15.33-.3.51-.15.18-.32.4-.46.54-.15.15-.31.32-.13.63.18.31.8 1.31 1.71 2.12 1.17 1.04 2.16 1.36 2.47 1.51.31.15.49.13.67-.08.18-.21.77-.9 1.02-1.21.25-.31.5-.26.84-.13.34.13 2.16 1.02 2.53 1.21.37.19.62.28.71.43.09.16.09.91-.15 1.59z"/>
  </svg>
  <span>{label}</span>
</a>
