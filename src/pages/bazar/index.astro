---
import Layout from '../../layouts/Layout.astro';

const CATALOG_URL = 'https://bazaremerald.vercel.app/catalogo.html';

const steps = [
  { title: 'Mira el catálogo', text: 'Figuras, llaveros y accesorios Pokémon impresos en 3D.' },
  { title: 'Haz tu pedido', text: 'Elige lo que quieres y ordénalo desde el mismo catálogo.' },
  { title: 'Apoyas a la comunidad', text: 'Lo que compras se convierte en premios y eventos para todos.' },
];
---

<Layout
  title="Bazar Emerald | Impresiones 3D de la comunidad Emerald City"
  description="Bazar Emerald es el sistema de compras y pedidos de impresiones 3D de Emerald City. Cada compra va a los fondos de la comunidad."
  image="/images/branding/logo-bazar-emerald.jpg"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-24">
    <section class="glass-panel rounded-3xl p-6 sm:p-10 text-center">
      <img
        src="/images/branding/logo-bazar-emerald.jpg"
        alt="Bazar Emerald"
        class="w-28 h-28 sm:w-32 sm:h-32 mx-auto rounded-2xl object-cover border border-amber-500/40 shadow-amber-glow"
      />
      <h1 class="text-4xl sm:text-5xl font-black text-zinc-100 tracking-tight mt-6">
        Bazar <span class="text-amber-400">Emerald</span>
      </h1>
      <p class="text-lg text-zinc-300 leading-relaxed mt-4 max-w-2xl mx-auto">
        Bazar Emerald es el sistema de compras y pedidos de <strong class="text-zinc-100">impresiones 3D</strong> de la comunidad.
      </p>
      <p class="text-base text-zinc-400 leading-relaxed mt-3 max-w-2xl mx-auto">
        Muchos de nuestros premios los costean los administradores, así que <strong class="text-amber-300">cada compra en el Bazar va directo a los fondos de la comunidad</strong> para hacer más y mejores cosas.
      </p>
      <a
        href={CATALOG_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-8 py-4 text-base font-black uppercase tracking-wider text-zinc-950 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 rounded-xl shadow-amber-glow transition-all hover:scale-[1.02]"
      >
        Ver el catálogo
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
      </a>
    </section>

    <ol class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
      {steps.map((step, i) => (
        <li class="glass-panel rounded-2xl p-5">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Paso {i + 1}</span>
          <p class="font-bold text-zinc-100 mt-1">{step.title}</p>
          <p class="text-sm text-zinc-400 mt-1">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</Layout>
