---
import Layout from '../../layouts/Layout.astro';
import { GIMMI_PASS_WHATSAPP_PHONE } from '../../utils/whatsapp';

const orderUrl = `https://wa.me/${GIMMI_PASS_WHATSAPP_PHONE}?text=${encodeURIComponent('¡Hola Gimmi Pass! Quiero hacer un pedido.')}`;
const phoneLabel = '+58 422 4050411';

const steps = [
  { title: 'Escríbenos', text: 'Toca el botón y se abre el chat de Gimmi Pass en WhatsApp.' },
  { title: 'Pide lo que necesitas', text: 'Cuéntanos qué quieres comprar o vender de Pokémon GO.' },
  { title: 'Lo recibes en el juego', text: 'Todo se entrega dentro de la misma aplicación.' },
];
---

<Layout
  title="Gimmi Pass | Compra y venta de Pokémon GO en Emerald City"
  description="Gimmi Pass es el sistema automatizado de Emerald City para comprar y vender cosas de Pokémon GO dentro de la aplicación."
  image="/images/branding/logo-gimmi-pass.jpg"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-24">
    <section class="glass-panel rounded-3xl p-6 sm:p-10 text-center">
      <a href={orderUrl} target="_blank" rel="noopener noreferrer" aria-label="Hacer un pedido a Gimmi Pass por WhatsApp" class="inline-block">
        <img
          src="/images/branding/logo-gimmi-pass.jpg"
          alt="Gimmi Pass"
          class="w-28 h-28 sm:w-32 sm:h-32 mx-auto rounded-2xl object-contain bg-white p-2 border border-emerald-500/40 shadow-emerald-glow transition-transform hover:scale-105"
        />
      </a>
      <h1 class="text-4xl sm:text-5xl font-black text-zinc-100 tracking-tight mt-6">
        Gimmi <span class="text-emerald-400">Pass</span>
      </h1>
      <p class="text-lg text-zinc-300 leading-relaxed mt-4 max-w-2xl mx-auto">
        Gimmi Pass es el <strong class="text-zinc-100">sistema automatizado para comprar y vender cosas de Pokémon GO</strong> dentro de la misma aplicación.
      </p>
      <p class="text-base text-zinc-400 leading-relaxed mt-3 max-w-2xl mx-auto">
        Con un toque te llevamos al WhatsApp de Gimmi Pass para hacer cualquier pedido.
      </p>
      <a
        href={orderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-8 py-4 text-base font-black uppercase tracking-wider text-zinc-950 bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400 rounded-xl shadow-emerald-glow-lg transition-all hover:scale-[1.02]"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z" />
        </svg>
        Hacer un pedido
      </a>
      <p class="text-sm text-zinc-400 mt-3">WhatsApp de Gimmi Pass: <span class="font-semibold text-zinc-200 select-all">{phoneLabel}</span></p>
    </section>

    <ol class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
      {steps.map((step, i) => (
        <li class="glass-panel rounded-2xl p-5">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Paso {i + 1}</span>
          <p class="font-bold text-zinc-100 mt-1">{step.title}</p>
          <p class="text-sm text-zinc-400 mt-1">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</Layout>
