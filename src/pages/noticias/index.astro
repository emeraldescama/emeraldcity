---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('noticias');
const sortedNews = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
  title="Noticias y Quedadas | Emerald City Pokémon GO Caracas"
  description="Eventos comunitarios, Community Days, horas de incursiones legendarias y quedadas oficiales de Pokémon GO en Caracas."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    
    <!-- Page Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 uppercase tracking-wider mb-4">
        Calendario & Avisos
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-zinc-100 tracking-tight">
        Noticias y Quedadas en <span class="text-emerald-400">Caracas</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 mt-4 leading-relaxed">
        Mantente al día con los próximos eventos presenciales, rutas de farmeo de experiencia, estrategias de incursiones y novedades oficiales de Pokémon GO.
      </p>
    </div>

    <!-- News Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedNews.map((news) => (
        <NewsCard
          slug={news.slug}
          title={news.data.title}
          date={news.data.date}
          category={news.data.category}
          description={news.data.description}
          image={news.data.image}
          author={news.data.author}
        />
      ))}
    </div>

    {sortedNews.length === 0 && (
      <div class="text-center py-20 glass-card rounded-2xl border border-zinc-800">
        <p class="text-zinc-400 text-base">No hay noticias publicadas en este momento.</p>
      </div>
    )}

    <!-- Admin CTA Banner -->
    <div class="mt-20 p-6 rounded-2xl glass-card border border-emerald-500/20 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 flex-shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-zinc-200">¿Eres parte del equipo organizador de Emerald City?</h4>
          <p class="text-xs text-zinc-400">Puedes crear o editar artículos y convocatorias desde el panel de administración.</p>
        </div>
      </div>
      <a
        href="/admin/"
        class="px-4 py-2 text-xs font-bold uppercase tracking-wider text-emerald-300 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-500/40 rounded-xl transition-colors whitespace-nowrap"
      >
        Ir a Decap CMS
      </a>
    </div>

  </div>
</Layout>
