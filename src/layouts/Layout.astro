---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Emerald City | Comunidad de Pokémon GO Caracas",
  description = "Portal oficial de la comunidad de Pokémon GO Emerald City en Caracas (@emeraldcityccs). Quedadas, horas de raids, Bazar 3D y Gimmi Pass.",
  image = "/images/branding/logo-emerald-city.png",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://emeraldcityccs.com');
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/branding/logo-emerald-city-256.png" />
    <link rel="apple-touch-icon" href="/images/branding/logo-emerald-city-256.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-sans min-h-screen flex flex-col selection:bg-emerald-500 selection:text-black antialiased relative overflow-x-hidden">
    <!-- Atmospheric Background Effects (Rayquaza Emerald & Amber Glows) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Emerald ambient orb top-left -->
      <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-emerald-500/10 rounded-full blur-[140px]"></div>
      <!-- Dragon Dark Green center glow -->
      <div class="absolute top-1/3 -right-40 w-[550px] h-[550px] bg-emerald-600/10 rounded-full blur-[160px]"></div>
      <!-- Amber accent bottom-left -->
      <div class="absolute bottom-10 left-1/4 w-[400px] h-[400px] bg-amber-500/5 rounded-full blur-[140px]"></div>
      <!-- Subtle Tech Grid Pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#10b9810a_1px,transparent_1px),linear-gradient(to_bottom,#10b9810a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
    </div>

    <!-- Main Navigation -->
    <Navbar />

    <!-- Content Slot -->
    <main class="flex-grow relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>

<style is:global>
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #090d12;
  }
  ::-webkit-scrollbar-thumb {
    background: #064e3b;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #10b981;
  }

  /* Glassmorphism utility */
  .glass-panel {
    background: rgba(11, 19, 25, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(16, 185, 129, 0.15);
  }

  .glass-card {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(16, 185, 129, 0.12);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glass-card:hover {
    border-color: rgba(52, 211, 153, 0.4);
    box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.25);
    transform: translateY(-2px);
  }
</style>
