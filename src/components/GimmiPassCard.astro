---
import WhatsAppButton from './WhatsAppButton.astro';
import { getGimmiPassWhatsAppUrl } from '../utils/whatsapp';

interface Props {
  name: string;
  description: string;
  items_included: string[];
  price_ref: number;
  image: string;
  featured?: boolean;
}

const {
  name,
  description,
  items_included,
  price_ref,
  image,
  featured = false,
} = Astro.props;

const whatsappUrl = getGimmiPassWhatsAppUrl(name, price_ref);
---

<div class={`glass-card rounded-2xl overflow-hidden flex flex-col justify-between relative transition-all duration-300 ${
  featured
    ? 'border-2 border-amber-400/80 shadow-amber-glow scale-[1.02] bg-zinc-900/90'
    : 'border border-emerald-500/30 bg-zinc-950/70 hover:border-emerald-400/60'
}`}>
  
  <!-- Featured Ribbon -->
  {featured && (
    <div class="absolute top-0 right-0">
      <div class="bg-gradient-to-r from-amber-400 to-amber-500 text-zinc-950 text-[11px] font-black uppercase tracking-wider px-4 py-1 rounded-bl-xl shadow-md flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        Recomendado
      </div>
    </div>
  )}

  <div class="p-6 sm:p-7">
    <!-- Header with Icon & Title -->
    <div class="flex items-center gap-4 mb-4">
      <div class="w-16 h-16 rounded-xl overflow-hidden bg-zinc-900 border border-emerald-500/20 flex-shrink-0">
        <img src={image} alt={name} class="w-full h-full object-cover" />
      </div>
      <div>
        <h3 class="text-xl font-black text-zinc-100 leading-tight">
          {name}
        </h3>
        <p class="text-xs text-emerald-400 font-semibold mt-1">
          Comunidad Caracas
        </p>
      </div>
    </div>

    <!-- Description -->
    <p class="text-zinc-400 text-sm leading-relaxed mb-6">
      {description}
    </p>

    <!-- Price Box -->
    <div class="p-4 rounded-xl bg-zinc-900/90 border border-zinc-800/80 flex items-baseline justify-between mb-6">
      <span class="text-xs font-bold uppercase tracking-wider text-zinc-400">
        Referencia:
      </span>
      <div class="text-right">
        <span class="text-3xl font-black text-amber-400 font-mono">
          ${price_ref.toFixed(2)}
        </span>
        <span class="text-xs text-zinc-400 ml-1">USD</span>
      </div>
    </div>

    <!-- Included Items List -->
    <div>
      <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-300 mb-3">
        Contenido del paquete:
      </h4>
      <ul class="space-y-2.5 text-sm text-zinc-300">
        {items_included.map((item) => (
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span class="text-xs sm:text-sm text-zinc-300 leading-tight">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom Action -->
  <div class="p-6 sm:p-7 pt-0">
    <WhatsAppButton
      href={whatsappUrl}
      label="Adquirir vía WhatsApp"
      variant={featured ? 'amber' : 'primary'}
      size="md"
      fullWidth={true}
    />
  </div>
</div>
