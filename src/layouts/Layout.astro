---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Emerald City | Comunidad de Pokémon GO Caracas",
  description = "Portal oficial de la comunidad de Pokémon GO Emerald City en Caracas (@emeraldcityccs). Quedadas, horas de raids, Bazar 3D y Gimmi Pass.",
  image = "/images/branding/logo-emerald-city.png",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://emeraldcityccs.com');
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/branding/logo-emerald-city-256.png" />
    <link rel="apple-touch-icon" href="/images/branding/logo-emerald-city-256.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Fuente Outfit alojada en la página: evita conectarse a Google antes de mostrar el texto -->
    <link rel="preload" href="/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Outfit';
        font-style: normal;
        font-weight: 400 900;
        font-display: swap;
        src: url('/fonts/outfit-latin.woff2') format('woff2');
      }
    </style>
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-sans min-h-screen flex flex-col selection:bg-emerald-500 selection:text-black antialiased relative overflow-x-hidden">
    <!-- Brillos de fondo: degradados en vez de desenfoques, que en el celular cuestan mucho -->
    <div
      class="fixed inset-0 pointer-events-none z-0"
      style="background:
        radial-gradient(600px circle at 0% 0%, rgba(16, 185, 129, 0.10), transparent 70%),
        radial-gradient(550px circle at 100% 40%, rgba(5, 150, 105, 0.09), transparent 70%),
        radial-gradient(420px circle at 30% 100%, rgba(245, 158, 11, 0.05), transparent 70%);"
    ></div>
    <div class="hidden md:block fixed inset-0 pointer-events-none z-0 bg-[linear-gradient(to_right,#10b9810a_1px,transparent_1px),linear-gradient(to_bottom,#10b9810a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

    <!-- Main Navigation -->
    <Navbar />

    <!-- Content Slot -->
    <main class="flex-grow relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>

<style is:global>
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #090d12;
  }
  ::-webkit-scrollbar-thumb {
    background: #064e3b;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #10b981;
  }

  /* Paneles tipo vidrio. En el celular van con fondo sólido: el desenfoque (backdrop-filter)
     hace lento el scroll en teléfonos sencillos y sobre el fondo oscuro casi no se nota */
  .glass-panel {
    background: rgba(11, 19, 25, 0.94);
    border: 1px solid rgba(16, 185, 129, 0.15);
  }

  .glass-card {
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(16, 185, 129, 0.12);
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }

  @media (min-width: 1024px) {
    .glass-panel {
      background: rgba(11, 19, 25, 0.7);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  }

  .glass-card:hover {
    border-color: rgba(52, 211, 153, 0.4);
    box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.25);
    transform: translateY(-2px);
  }

  /* Insignia de miembro activo de Escama Esmeralda (foro, eventos) */
  .escama-badge {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    cursor: help;
    border-radius: 999px;
    animation: escama-brillo 2.6s ease-in-out infinite;
  }
  .escama-badge-md {
    width: 1.75rem;
    height: 1.75rem;
  }
  .escama-badge svg {
    width: 100%;
    height: 100%;
  }
  @keyframes escama-brillo {
    0%,
    100% {
      filter: drop-shadow(0 0 2px rgba(74, 222, 128, 0.55));
    }
    50% {
      filter: drop-shadow(0 0 7px rgba(74, 222, 128, 0.95)) brightness(1.15);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .escama-badge {
      animation: none;
      filter: drop-shadow(0 0 4px rgba(74, 222, 128, 0.8));
    }
  }
  .escama-badge::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%);
    z-index: 40;
    white-space: nowrap;
    padding: 0.35rem 0.6rem;
    border-radius: 0.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    color: #dcfce7;
    background: #052e16;
    border: 1px solid rgba(74, 222, 128, 0.6);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }
  .escama-badge:hover::after,
  .escama-badge:focus-visible::after,
  .escama-badge-tip::after {
    opacity: 1;
  }
</style>
