---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getGeneralContactWhatsAppUrl } from '../utils/whatsapp';

const infoUrl = getGeneralContactWhatsAppUrl();

const steps = ['Tus datos', 'Tu perfil', 'Campfire', 'Último paso'];
const inputClass = 'w-full rounded-xl bg-zinc-900/90 border border-zinc-700 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-500/30 outline-none px-4 py-3.5 text-base text-zinc-100 placeholder:text-zinc-500 transition-colors';
const labelClass = 'block text-sm font-bold text-zinc-100 mb-1.5';
const helpClass = 'text-xs text-zinc-400 mt-1.5';
const tipClass = 'rounded-xl bg-emerald-500/5 border border-emerald-500/20 p-4 text-sm text-zinc-300';
---

<Layout
  title="Únete a Emerald City | Comunidad Pokémon GO Caracas"
  description="Regístrate en Emerald City, la comunidad de Pokémon GO de Caracas. Solo toma unos minutos."
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 pb-24">

    <!-- Encabezado -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 uppercase tracking-wider mb-4">
        Registro de entrenadores
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-zinc-100 tracking-tight">
        Únete a <span class="text-emerald-400">Emerald City</span>
      </h1>
      <p class="text-base text-zinc-400 mt-3">Son 4 pasos cortos y te toma unos 3 minutos.</p>
    </div>

    <!-- Progreso -->
    <ol id="progreso" class="grid grid-cols-4 gap-2 mb-6" aria-label="Pasos del registro">
      {steps.map((name, i) => (
        <li class="progreso-paso flex flex-col gap-2" data-paso={i + 1}>
          <span class="h-1.5 rounded-full bg-zinc-800 overflow-hidden">
            <span class="progreso-barra block h-full w-0 bg-gradient-to-r from-emerald-500 to-emerald-400 transition-all duration-500"></span>
          </span>
          <span class="progreso-texto text-[11px] sm:text-xs font-bold uppercase tracking-wider text-zinc-500">{name}</span>
        </li>
      ))}
    </ol>

    <form id="registro" class="glass-panel rounded-3xl p-6 sm:p-8" novalidate>
      <!-- Campo trampa para bots -->
      <input type="text" name="sitio" id="sitio" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <!-- Paso 1 -->
      <fieldset data-paso="1" class="paso space-y-6">
        <legend class="text-2xl font-black text-zinc-100 tracking-tight mb-1">Cuéntanos quién eres</legend>

        <div>
          <label for="entrenador" class={labelClass}>Nombre de entrenador</label>
          <input id="entrenador" name="entrenador" type="text" required maxlength="30" autocomplete="nickname" placeholder="Ej: RayquazaCCS" class={inputClass} />
          <p class={helpClass}>Tal como aparece en Pokémon GO.</p>
        </div>

        <div>
          <label for="nombre" class={labelClass}>Nombre y apellido</label>
          <input id="nombre" name="nombre" type="text" required maxlength="80" autocomplete="name" placeholder="Ej: María Pérez" class={inputClass} />
          <p class={helpClass}>Solo lo ven los organizadores.</p>
        </div>

        <div>
          <label for="ciudad" class={labelClass}>Ciudad o país</label>
          <input id="ciudad" name="ciudad" type="text" required maxlength="60" autocomplete="address-level2" placeholder="Ej: Caracas, Venezuela" class={inputClass} />
          <p class={helpClass}>Aparece junto a tu código en la lista de amigos.</p>
        </div>
      </fieldset>

      <!-- Paso 2 -->
      <fieldset data-paso="2" class="paso hidden space-y-6">
        <legend class="text-2xl font-black text-zinc-100 tracking-tight mb-1">Tu perfil en el juego</legend>

        <div>
          <span class={labelClass}>Captura de tu perfil</span>
          <label for="captura" id="captura-zona" class="block cursor-pointer rounded-2xl border-2 border-dashed border-zinc-700 hover:border-emerald-400/60 transition-colors overflow-hidden">
            <img id="captura-vista" alt="Tu captura" class="hidden w-full max-h-[420px] object-contain bg-zinc-950" />
            <span id="captura-vacia" class="flex flex-col items-center gap-2 py-10 px-4 text-center">
              <svg class="w-9 h-9 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="3" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <path d="M21 15l-5-5L5 21" />
              </svg>
              <span class="text-sm font-bold text-zinc-200">Toca para subir tu captura</span>
              <span class="text-xs text-zinc-400">Donde se vea tu nombre de entrenador y tu compañero Pokémon</span>
            </span>
          </label>
          <input id="captura" name="captura" type="file" accept="image/*" class="sr-only" />
          <p id="captura-error" class="text-sm text-red-400 mt-2 hidden" role="alert"></p>

          <details class={`${tipClass} mt-3`}>
            <summary class="cursor-pointer font-bold text-emerald-300">¿Cómo hago la captura?</summary>
            <ol class="list-decimal pl-5 mt-3 space-y-1.5">
              <li>Abre Pokémon GO y toca tu avatar, abajo a la izquierda.</li>
              <li>En la pestaña <strong>Yo</strong> verás tu nombre de entrenador y tu compañero Pokémon.</li>
              <li>Toma la captura: en <strong>Android</strong>, botón de encendido + bajar volumen; en <strong>iPhone</strong>, botón lateral + subir volumen.</li>
            </ol>
          </details>
        </div>

        <div>
          <label for="codigo" class={labelClass}>Código de amistad</label>
          <input id="codigo" name="codigo" type="text" inputmode="numeric" required autocomplete="off" placeholder="1234 5678 9012" maxlength="14" class={`${inputClass} font-mono tracking-widest`} />
          <details class={`${tipClass} mt-3`}>
            <summary class="cursor-pointer font-bold text-emerald-300">¿Dónde encuentro mi código?</summary>
            <ol class="list-decimal pl-5 mt-3 space-y-1.5">
              <li>En Pokémon GO, toca tu avatar, abajo a la izquierda.</li>
              <li>Arriba, entra en la pestaña <strong>Amigos</strong>.</li>
              <li>Toca <strong>Agregar amigo</strong>: ahí está tu código de entrenador de 12 números.</li>
              <li>Toca <strong>Copiar mi código de entrenador</strong> y pégalo aquí.</li>
            </ol>
          </details>
        </div>

        <label class="flex items-start gap-3 cursor-pointer rounded-xl border border-zinc-800 p-4 hover:border-emerald-500/40 transition-colors">
          <input id="mostrar-amigos" name="mostrarEnAmigos" type="checkbox" checked class="mt-0.5 w-5 h-5 accent-emerald-500 flex-shrink-0" />
          <span class="text-sm text-zinc-300">
            <strong class="text-zinc-100">Quiero aparecer en "Haz amigos"</strong><br />
            Mostramos tu nombre de entrenador, tu código y tu ciudad para que otros entrenadores te agreguen.
          </span>
        </label>
      </fieldset>

      <!-- Paso 3 -->
      <fieldset data-paso="3" class="paso hidden space-y-6">
        <legend class="text-2xl font-black text-zinc-100 tracking-tight mb-1">Campfire</legend>

        <div class={tipClass}>
          <p class="font-bold text-emerald-300 mb-1">¿Qué es Campfire?</p>
          <p>
            Es la app oficial complementaria de Pokémon GO: muestra en un mapa los eventos cercanos, te deja chatear con entrenadores de tu zona y ahí coordinamos las quedadas de Emerald City. Se inicia sesión con la misma cuenta del juego.
          </p>
          <details class="mt-3">
            <summary class="cursor-pointer font-bold text-emerald-300">¿Cómo la instalo en Venezuela?</summary>
            <p class="mt-2">Campfire no aparece en las tiendas de Venezuela. En Android se instala con el archivo APK y una VPN; mira el video paso a paso:</p>
            <video controls preload="none" playsinline class="mt-3 w-full max-h-[420px] rounded-xl bg-black">
              <source src="/video/tutorial_campfire_android.mp4" type="video/mp4" />
            </video>
          </details>
        </div>

        <div>
          <span class={labelClass}>¿Tienes cuenta en Campfire?</span>
          <div class="grid grid-cols-2 gap-3">
            <label class="opcion cursor-pointer rounded-xl border border-zinc-700 p-4 text-center font-bold text-zinc-200 transition-colors">
              <input type="radio" name="campfire" value="si" required class="sr-only" />
              Sí, tengo
            </label>
            <label class="opcion cursor-pointer rounded-xl border border-zinc-700 p-4 text-center font-bold text-zinc-200 transition-colors">
              <input type="radio" name="campfire" value="no" class="sr-only" />
              Todavía no
            </label>
          </div>
        </div>

        <div id="campfire-nombre-bloque" class="hidden">
          <label for="campfire-nombre" class={labelClass}>Tu nombre en Campfire</label>
          <input id="campfire-nombre" name="campfireNombre" type="text" maxlength="30" placeholder="Ej: RayquazaCCS" class={inputClass} />
          <p class={helpClass}>Así te encontramos para invitarte a las quedadas.</p>
        </div>

        <p id="campfire-no" class="hidden text-sm text-zinc-300">
          No pasa nada: puedes continuar y crearla cuando quieras.
        </p>
      </fieldset>

      <!-- Paso 4 -->
      <fieldset data-paso="4" class="paso hidden space-y-6">
        <legend class="text-2xl font-black text-zinc-100 tracking-tight mb-1">Último paso</legend>

        <div>
          <label for="edad" class={labelClass}>Edad</label>
          <input id="edad" name="edad" type="number" inputmode="numeric" required min="1" max="120" placeholder="Ej: 24" class={`${inputClass} max-w-[10rem]`} />
        </div>

        <div id="edad-minima" class="hidden rounded-xl bg-red-500/10 border border-red-500/40 p-4 text-sm text-red-200" role="alert">
          <p class="font-bold">Lo sentimos, todavía no puedes registrarte.</p>
          <p class="mt-1">Emerald City admite personas desde los 16 años, por la seguridad de jugar en espacios abiertos usando el celular.</p>
        </div>
      </fieldset>

      <p id="registro-error" class="hidden mt-6 text-sm text-red-300 bg-red-500/10 border border-red-500/40 rounded-xl p-3" role="alert"></p>

      <!-- Navegación -->
      <div class="flex items-center justify-between gap-3 mt-8">
        <button id="atras" type="button" class="invisible px-5 py-3 text-sm font-bold text-zinc-300 hover:text-zinc-100 rounded-xl border border-zinc-700 hover:border-zinc-500 transition-colors">
          Atrás
        </button>
        <button id="continuar" type="submit" class="flex-1 sm:flex-none px-8 py-3.5 text-sm font-black uppercase tracking-wider text-zinc-950 bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400 rounded-xl shadow-emerald-glow transition-all disabled:opacity-50 disabled:cursor-not-allowed">
          Continuar
        </button>
      </div>
    </form>

    <!-- Registro enviado -->
    <section id="registro-listo" class="hidden glass-panel rounded-3xl p-8 sm:p-10 text-center">
      <div class="w-16 h-16 mx-auto rounded-full bg-emerald-500/15 border border-emerald-500/40 flex items-center justify-center text-emerald-400 mb-5">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
      </div>
      <h2 class="text-3xl font-black text-zinc-100 tracking-tight">¡Listo, <span id="listo-entrenador" class="text-emerald-400"></span>!</h2>
      <p class="text-base text-zinc-300 mt-3">Recibimos tu registro. Los organizadores revisarán tus datos y te contactarán para darte la bienvenida a la comunidad.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-3 mt-8">
        <a href="/amigos" class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-zinc-950 bg-gradient-to-r from-emerald-400 to-emerald-500 rounded-xl shadow-emerald-glow">
          Haz amigos en la comunidad
        </a>
        <WhatsAppButton href={infoUrl} label="Más información" variant="secondary" size="md" />
      </div>
    </section>
  </div>
</Layout>

<style>
  .opcion:has(input:checked) {
    border-color: #34d399;
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
  }
  .opcion:has(input:focus-visible) {
    outline: 2px solid #34d399;
    outline-offset: 2px;
  }
  .progreso-paso[data-estado='hecho'] .progreso-barra,
  .progreso-paso[data-estado='actual'] .progreso-barra {
    width: 100%;
  }
  .progreso-paso[data-estado='actual'] .progreso-texto {
    color: #34d399;
  }
  .progreso-paso[data-estado='hecho'] .progreso-texto {
    color: #a1a1aa;
  }
</style>

<script>
  import { initRegistro } from '../scripts/registro';
  initRegistro();
</script>
