---
interface Props {
  slug: string;
  title: string;
  date: Date;
  category: 'Juego' | 'Quedada';
  description: string;
  image: string;
  author?: string;
}

const { slug, title, date, category, description, image, author = 'Emerald City Team' } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('es-VE', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date(date));

const categoryBadgeClass = category === 'Quedada'
  ? 'bg-amber-500/20 text-amber-300 border-amber-500/40'
  : 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40';
---

<article class="glass-card rounded-2xl overflow-hidden flex flex-col group h-full">
  <!-- Post Thumbnail Container -->
  <a href={`/noticias/${slug}`} class="relative block overflow-hidden aspect-[16/10] bg-zinc-900" aria-label={title}>
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent opacity-80"></div>
    
    <!-- Category Badge -->
    <div class="absolute top-3.5 left-3.5">
      <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border backdrop-blur-md uppercase tracking-wider ${categoryBadgeClass}`}>
        {category}
      </span>
    </div>

    <!-- Date Badge -->
    <div class="absolute bottom-3 right-3 text-xs font-semibold text-zinc-300 bg-zinc-950/80 px-2.5 py-1 rounded-lg border border-zinc-800 backdrop-blur-md">
      {formattedDate}
    </div>
  </a>

  <!-- Content -->
  <div class="p-6 flex-grow flex flex-col justify-between">
    <div>
      <a href={`/noticias/${slug}`} class="block group-hover:text-emerald-400 transition-colors">
        <h3 class="text-lg sm:text-xl font-bold text-zinc-100 line-clamp-2 tracking-tight leading-snug">
          {title}
        </h3>
      </a>
      <p class="text-zinc-400 text-sm mt-3 line-clamp-3 leading-relaxed">
        {description}
      </p>
    </div>

    <div class="pt-5 mt-5 border-t border-zinc-800/80 flex items-center justify-between">
      <span class="text-xs text-zinc-400">Por {author}</span>
      <a
        href={`/noticias/${slug}`}
        class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 hover:text-emerald-300 uppercase tracking-wider group-hover:translate-x-1 transition-transform"
      >
        Leer más
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    </div>
  </div>
</article>
