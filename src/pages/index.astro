---
import Layout from '../layouts/Layout.astro';
import AboutCommunity from '../components/AboutCommunity.astro';
import Countdown from '../components/Countdown.astro';
import WeeklyEvents from '../components/WeeklyEvents.astro';
import { getEventos } from '../utils/getEventos';

// Eventos cargados desde el panel y la sincronización automática
const eventos = await getEventos();

const shortcuts = [
  {
    href: '/amigos',
    title: 'Haz amigos',
    text: 'Copia los códigos de amistad de la comunidad y agrégalos en Pokémon GO.',
    action: 'Ver códigos',
    image: '/images/branding/logo-emerald-city.png',
  },
  {
    href: '/bazar',
    title: 'Bazar Emerald',
    text: 'Figuras y accesorios Pokémon impresos en 3D en Caracas.',
    action: 'Ver catálogo',
    image: '/images/branding/logo-bazar-emerald.jpg',
  },
  {
    href: '/gimmi-pass',
    title: 'Gimmi Pass',
    text: 'Pases de incursión y paquetes para la comunidad.',
    action: 'Ver paquetes',
    image: '/images/branding/logo-gimmi-pass.jpg',
  },
];
---

<Layout
  title="Emerald City | Comunidad Pokémon GO Caracas (@emeraldcityccs)"
  description="Emerald City es la comunidad de Pokémon GO de Caracas: Días de la Comunidad en el Parque del Este, incursiones en Plaza Los Palos Grandes y mucho más."
>
  <!-- 1. Quiénes somos y botón para unirse -->
  <AboutCommunity />

  <!-- 2. Noticias y quedadas (se actualizan solas) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10">
      <Countdown eventos={eventos} />
    </div>
    <WeeklyEvents eventos={eventos} invitacion={false} />
    <div class="-mt-12 mb-20 text-center">
      <a href="/noticias" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-emerald-400 hover:text-emerald-300">
        Ver todas las noticias y quedadas
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
      </a>
    </div>
  </section>

  <!-- 3. Accesos rápidos -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {shortcuts.map((s) => (
        <a href={s.href} class="glass-card rounded-2xl p-6 flex items-start gap-4 group">
          <img src={s.image} alt="" class="w-14 h-14 rounded-xl object-contain bg-zinc-900 border border-emerald-500/30 p-1 flex-shrink-0" />
          <div>
            <h2 class="text-xl font-black text-zinc-100 group-hover:text-emerald-400 transition-colors">{s.title}</h2>
            <p class="text-sm text-zinc-400 mt-1">{s.text}</p>
            <span class="inline-block mt-3 text-xs font-bold uppercase tracking-wider text-emerald-400">{s.action} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
