---
import Layout from '../layouts/Layout.astro';
import { getGeneralContactWhatsAppUrl } from '../utils/whatsapp';

const helpUrl = getGeneralContactWhatsAppUrl('Hola, tengo una duda sobre las misiones de Wild Area de Emerald City.');
const joinUrl = getGeneralContactWhatsAppUrl('¡Hola! Quiero unirme a la aventura del Wild Area de Emerald City y ser miembro de Escama Esmeralda. ¿Cómo hago? 🌧️');
const artwork = (n: number) => `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${n}.png`;
---

<Layout
  title="Wild Area | Emerald City"
  description="Misiones diarias del Wild Area para los miembros de Escama Esmeralda: marca tus logros, muéstraselos al admin en la quedada y suma puntos."
>
  <div class="wa">
    <!-- Portada con la temática del Wild Area: nubes Dinamax, lluvia y pasto -->
    <section class="wa-hero">
      <div class="wa-rain" aria-hidden="true"></div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 pb-24 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <p class="wa-chip">Exclusivo Escama Esmeralda</p>
          <h1 class="wa-title">WILD AREA</h1>
          <p id="wa-nombre" class="text-2xl sm:text-3xl font-black text-zinc-100 tracking-tight">Misiones del Wild Area</p>
          <p id="wa-fechas" class="mt-2 text-sm font-bold uppercase tracking-wider text-pink-200/90"></p>
          <p class="mt-4 text-zinc-200/90 max-w-xl">Cumple las misiones de cada día, toca <strong class="text-white">"¡Lo logré!"</strong> y muéstrale tu logro al admin en la quedada. Cada logro validado suma puntos para la tabla final.</p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <button id="wa-registrarme" type="button" class="hidden wa-button text-lg px-7 py-3.5">✨ Registrarme</button>
            <span id="wa-registrado" class="hidden items-center gap-2 px-4 py-2.5 rounded-xl border border-emerald-400/60 bg-emerald-500/15 text-emerald-100 font-black">✓ Ya estás registrado</span>
            <p id="wa-progreso" class="hidden wa-progress"></p>
          </div>
        </div>
        <div class="wa-art" aria-hidden="true">
          <img src={artwork(10225)} alt="" width="320" height="320" class="wa-art-main" />
          <img src={artwork(10188)} alt="" width="180" height="180" class="wa-art-left" loading="lazy" />
          <img src={artwork(10189)} alt="" width="180" height="180" class="wa-art-right" loading="lazy" />
        </div>
      </div>
      <svg class="wa-grass" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 70 C 180 20 300 110 520 60 C 720 15 860 100 1080 55 C 1250 20 1350 70 1440 45 L1440 120 L0 120 Z" fill="#14532d" />
        <path d="M0 95 C 220 60 380 120 620 85 C 860 50 1020 115 1240 80 C 1340 65 1400 85 1440 78 L1440 120 L0 120 Z" fill="#0b2b18" />
      </svg>
    </section>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-24 space-y-8 -mt-4 relative z-10">
      <!-- Para los nuevos: cómo unirse (se oculta a quien ya participa) -->
      <section id="wa-unete" class="wa-card p-6 sm:p-8 border-amber-300/40">
        <div class="flex flex-col md:flex-row md:items-center gap-6">
          <div class="text-5xl shrink-0" aria-hidden="true">🐉</div>
          <div class="flex-grow space-y-2">
            <p class="text-2xl font-black text-white">¿Quieres unirte a la aventura del Wild Area de Emerald?</p>
            <p class="text-zinc-200">Solo debes ser miembro de <strong class="text-amber-200">Escama Esmeralda</strong>, nuestro plan de apoyo a la comunidad: una donación de <strong class="text-amber-200">2 USD</strong> que nos ayuda a mantener las actividades de Emerald City.</p>
            <p class="text-sm text-zinc-300">Para más información y ser parte, escríbenos al <strong class="text-white">0422-2292700</strong>.</p>
          </div>
          <a href={joinUrl} target="_blank" rel="noopener" class="wa-button shrink-0 text-center">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.75-.71 2-1.4.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35M12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.43 9.43 0 1 1 7.99 4.42m8.02-17.45A11.27 11.27 0 0 0 12.04.75C5.8.75.72 5.83.72 12.07c0 2 .52 3.94 1.51 5.65L.62 23.6l6.02-1.58a11.3 11.3 0 0 0 5.4 1.38h.01c6.24 0 11.32-5.08 11.32-11.32 0-3.03-1.18-5.87-3.31-8.01"/></svg>
            Quiero ser parte
          </a>
        </div>
      </section>

      <p id="wa-cargando" class="text-center text-zinc-300 py-10">Cargando misiones…</p>
      <p id="wa-error" class="hidden px-4 py-3 rounded-xl text-sm font-semibold border bg-red-500/15 border-red-500/50 text-red-200" role="alert"></p>

      <section id="wa-vacio" class="hidden wa-card p-10 text-center">
        <p class="text-xl font-black text-white">Las misiones del Wild Area se publican muy pronto</p>
        <p class="text-sm text-zinc-300 mt-2">Mantente atento al grupo de WhatsApp de Escama Esmeralda.</p>
      </section>

      <div id="wa-dinamicas" class="space-y-12"></div>
    </div>
  </div>

  <!-- Registro en el Wild Area: validar Escama Esmeralda con el teléfono -->
  <dialog id="wa-registro" class="wa-dialog m-auto w-[min(28rem,calc(100vw-2rem))] max-h-[calc(100dvh-2rem)] rounded-3xl p-0 text-zinc-100">
    <div class="p-6 space-y-4">
      <div class="flex items-start justify-between gap-3">
        <p class="text-2xl font-black text-white">Regístrate en el Wild Area 🌧️</p>
        <button id="wr-cerrar" type="button" aria-label="Cerrar" class="text-zinc-400 hover:text-white text-xl font-black px-1">✕</button>
      </div>

      <div id="wr-intro" class="space-y-3">
        <p class="text-zinc-200">El Wild Area de Emerald es un <strong class="text-white">evento exclusivo para los miembros activos de Escama Esmeralda</strong>, nuestro plan de apoyo a la comunidad.</p>
        <p class="text-zinc-200">Si ya eres miembro, escribe el número de teléfono con el que te inscribiste en Escama Esmeralda y <strong class="text-white">te registramos al instante</strong>.</p>
      </div>

      <!-- Sin sesión: primero la cuenta del foro -->
      <div id="wr-anon" class="hidden space-y-3 rounded-2xl border border-pink-300/30 bg-black/30 p-4">
        <p class="text-sm text-zinc-200">Para registrarte necesitas tu cuenta del foro de Emerald City. Entra con ella o créala en un minuto, y vuelves aquí solo.</p>
        <a id="wr-entrar" href="/foro" class="wa-button w-full">Entrar o crear mi cuenta</a>
      </div>

      <!-- Con sesión: el teléfono de Escama -->
      <form id="wr-form" class="hidden space-y-3" novalidate>
        <label for="wr-telefono" class="block text-sm font-bold text-white">Tu teléfono registrado en Escama Esmeralda</label>
        <input id="wr-telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="0412 1234567" class="w-full rounded-xl bg-black/40 border border-pink-300/30 focus:border-pink-300 outline-none px-4 py-3.5 text-lg text-white placeholder:text-zinc-500" />
        <p id="wr-error" class="hidden rounded-xl bg-red-500/15 border border-red-400/50 p-3 text-sm font-semibold text-red-100" role="alert"></p>
        <button type="submit" class="wa-button w-full text-lg">Registrarme</button>
        <p class="text-xs text-zinc-400">Solo lo usamos para comprobar tu suscripción. No se muestra a nadie.</p>
      </form>

      <!-- Otro motivo (por ejemplo, la suscripción venció) -->
      <p id="wr-motivo" class="hidden rounded-2xl border border-amber-300/40 bg-amber-500/10 p-4 text-sm text-amber-100"></p>

      <!-- Registro listo -->
      <div id="wr-ok" class="hidden space-y-3 text-center">
        <p class="text-5xl">🎉</p>
        <p class="text-xl font-black text-white">¡Listo<span id="wr-ok-nombre"></span>! Ya estás registrado.</p>
        <p class="text-zinc-200">Tu cuenta quedó vinculada a Escama Esmeralda. Ya puedes marcar tus logros en las misiones de cada día, y en el foro lucirás la escama verde de miembro activo.</p>
        <button id="wr-ver" type="button" class="wa-button w-full">Ver mis misiones</button>
      </div>

      <p id="wr-no-miembro" class="text-center text-sm text-zinc-300">¿Todavía no eres miembro de Escama Esmeralda? <a href={joinUrl} target="_blank" rel="noopener" class="font-bold text-pink-200 underline">Quiero ser parte</a></p>
    </div>
  </dialog>

  <!-- Después de "¡Lo logré!" -->
  <dialog id="wa-logrado" class="wa-dialog m-auto w-[min(26rem,calc(100vw-2rem))] rounded-3xl p-0 text-zinc-100">
    <div class="p-6 text-center space-y-4">
      <div id="wa-logrado-arte" class="flex justify-center -mt-2"></div>
      <p class="text-2xl font-black text-white">¡Lo lograste! 🎉</p>
      <p id="wa-logrado-mision" class="text-sm font-bold text-pink-200"></p>
      <p class="text-zinc-200">Acércate a la <strong>quedada de hoy</strong> y busca al <strong>admin Mauricio</strong>. Muéstrale tu logro en el juego y se te sumarán los puntos automáticamente en la página.</p>
      <a href={helpUrl} target="_blank" rel="noopener" class="block wa-button-ghost">¿Tienes dudas? Escríbenos por WhatsApp</a>
      <div class="flex flex-col gap-2">
        <button id="wa-logrado-ok" type="button" class="wa-button w-full">¡Entendido!</button>
        <button id="wa-logrado-deshacer" type="button" class="text-sm font-bold text-zinc-400 hover:text-zinc-200 underline">Me equivoqué, deshacer</button>
      </div>
    </div>
  </dialog>

  <input id="ev-archivo" type="file" accept="image/*" class="hidden" />
</Layout>

<script>
  import { initEventos } from '../scripts/eventosDinamicas';
  initEventos();
</script>

<style is:global>
  /* Algunas clases de esta página fijan display: "hidden" siempre debe poder ocultarlas */
  .wa .hidden,
  .wa-dialog .hidden {
    display: none !important;
  }
  /* Temática del Wild Area (solo esta página): cielo Dinamax, pasto de Galar y lluvia */
  .wa {
    --wa-pink: #ff3d7f;
    --wa-magenta: #d946ef;
    --wa-grass: #22c55e;
    background: linear-gradient(180deg, #14061f 0%, #1d0a2e 30%, #0b1f14 75%, #07130c 100%);
    margin-bottom: -1px;
  }
  .wa-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(900px 380px at 15% 0%, rgba(255, 61, 127, 0.45), transparent 70%),
      radial-gradient(700px 360px at 85% 10%, rgba(217, 70, 239, 0.4), transparent 70%),
      radial-gradient(600px 300px at 50% 60%, rgba(244, 63, 94, 0.18), transparent 70%),
      linear-gradient(180deg, #2a0b3d 0%, #3b0f4a 45%, #1d0a2e 100%);
  }
  .wa-rain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image: repeating-linear-gradient(105deg, transparent 0 22px, rgba(255, 255, 255, 0.5) 22px 23px, transparent 23px 46px);
    background-size: 200px 200px;
    animation: wa-rain 1.2s linear infinite;
  }
  @keyframes wa-rain {
    to {
      background-position: -60px 200px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-rain,
    .wa-art img {
      animation: none !important;
    }
  }
  .wa-grass {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 90px;
  }
  .wa-chip {
    display: inline-flex;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fde68a;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(251, 191, 36, 0.5);
  }
  .wa-title {
    margin-top: 0.75rem;
    font-size: clamp(3.4rem, 13vw, 7rem);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, #ff8fab, #ff3d7f 35%, #f0abfc 70%, #fde68a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 28px rgba(255, 61, 127, 0.55));
  }
  .wa-progress {
    display: inline-flex;
    padding: 0.5rem 0.9rem;
    border-radius: 0.9rem;
    font-weight: 800;
    color: #fff;
    background: rgba(255, 61, 127, 0.18);
    border: 1px solid rgba(255, 61, 127, 0.55);
  }
  .wa-art {
    position: relative;
    height: 300px;
  }
  .wa-art img {
    position: absolute;
    object-fit: contain;
    filter: drop-shadow(0 0 30px rgba(255, 61, 127, 0.6));
    animation: wa-float 6s ease-in-out infinite;
  }
  .wa-art-main {
    width: 300px;
    height: 300px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }
  .wa-art-left {
    width: 150px;
    height: 150px;
    left: 2%;
    bottom: 0;
    animation-delay: -2s !important;
  }
  .wa-art-right {
    width: 150px;
    height: 150px;
    right: 2%;
    bottom: 0;
    animation-delay: -4s !important;
  }
  @keyframes wa-float {
    50% {
      translate: 0 -10px;
    }
  }
  @media (max-width: 640px) {
    .wa-art {
      height: 210px;
    }
    .wa-art-main {
      width: 210px;
      height: 210px;
    }
    .wa-art-left,
    .wa-art-right {
      width: 105px;
      height: 105px;
    }
  }
  .wa-card {
    border-radius: 1.5rem;
    background: linear-gradient(180deg, rgba(42, 11, 61, 0.85), rgba(16, 24, 18, 0.9));
    border: 1px solid rgba(255, 61, 127, 0.28);
    box-shadow: 0 20px 60px -30px rgba(255, 61, 127, 0.5);
  }
  .wa-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.8rem 1.3rem;
    border-radius: 0.9rem;
    font-weight: 900;
    color: #fff;
    background: linear-gradient(135deg, #ff3d7f, #d946ef);
    box-shadow: 0 0 22px rgba(255, 61, 127, 0.45);
    transition: transform 0.15s, filter 0.15s;
  }
  .wa-button:hover {
    filter: brightness(1.1);
  }
  .wa-button:active {
    transform: scale(0.97);
  }
  .wa-button:disabled {
    opacity: 0.5;
    box-shadow: none;
  }
  .wa-button-ghost {
    padding: 0.7rem 1rem;
    border-radius: 0.9rem;
    font-weight: 800;
    font-size: 0.875rem;
    color: #86efac;
    border: 1px solid rgba(34, 197, 94, 0.45);
    background: rgba(34, 197, 94, 0.08);
  }
  .wa-day {
    flex-shrink: 0;
    min-width: 5.2rem;
    padding: 0.6rem 0.7rem;
    border-radius: 1rem;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.3);
    color: #e4e4e7;
  }
  .wa-day[aria-selected='true'] {
    border-color: #ff3d7f;
    background: linear-gradient(180deg, rgba(255, 61, 127, 0.35), rgba(217, 70, 239, 0.2));
    color: #fff;
    box-shadow: 0 0 20px rgba(255, 61, 127, 0.35);
  }
  .wa-day.wa-today {
    outline: 2px dashed rgba(253, 230, 138, 0.7);
    outline-offset: 2px;
  }
  .wa-mission {
    border-radius: 1.25rem;
    background: rgba(10, 6, 18, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .wa-mission.wa-open {
    border-color: rgba(255, 61, 127, 0.45);
  }
  .wa-orb {
    position: relative;
    width: 6.5rem;
    height: 6.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: radial-gradient(circle at 50% 45%, rgba(255, 61, 127, 0.4), rgba(217, 70, 239, 0.12) 60%, transparent 72%);
  }
  .wa-orb img {
    position: absolute;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.6));
  }
  .wa-dialog {
    background: linear-gradient(180deg, #2a0b3d, #0f1d14);
    border: 1px solid rgba(255, 61, 127, 0.5);
  }
  .wa-dialog::backdrop {
    background: rgba(10, 2, 18, 0.82);
  }
</style>
