---
const pathname = Astro.url.pathname;

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Conoce a la comunidad', href: '/#comunidad' },
  { name: 'Quiero ser parte', href: '/unirse', highlight: true },
  { name: 'Haz amigos', href: '/amigos' },
  { name: 'Bazar Emerald', href: '/bazar' },
  { name: 'Gimmi Pass', href: '/gimmi-pass' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href.startsWith('/#')) return false;
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-50 w-full glass-panel border-b border-emerald-500/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">

      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="Emerald City Inicio">
        <div class="relative w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center rounded-xl bg-zinc-900/80 border border-emerald-500/40 group-hover:border-emerald-400 group-hover:shadow-emerald-glow transition-all duration-300 p-1">
          <img
            src="/images/branding/logo-emerald-city-128.png"
            alt="Emerald City Logo Oficial"
            class="w-full h-full object-contain filter drop-shadow-[0_2px_8px_rgba(16,185,129,0.3)] transition-transform duration-300 group-hover:scale-110"
          />
        </div>
        <div>
          <span class="block font-black text-lg sm:text-xl tracking-wider text-zinc-100 uppercase group-hover:text-emerald-400 transition-colors">
            Emerald<span class="text-emerald-400">City</span>
          </span>
          <span class="block text-[10px] sm:text-[11px] font-semibold text-amber-400/90 tracking-widest uppercase">
            Caracas • Pokémon GO
          </span>
        </div>
      </a>

      <a
        href="https://instagram.com/emeraldcityccs"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 p-2.5 text-zinc-400 hover:text-pink-400 hover:bg-zinc-800/80 rounded-lg transition-colors border border-transparent hover:border-pink-500/20"
        title="Instagram @emeraldcityccs"
        aria-label="Instagram oficial"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
        </svg>
        <span class="hidden sm:inline text-sm font-semibold">@emeraldcityccs</span>
      </a>
    </div>
  </div>

  <!-- Menú: siempre visible; en el celular se desliza hacia los lados -->
  <nav class="border-t border-emerald-500/10" aria-label="Navegación principal">
    <ul class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-1.5 overflow-x-auto py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <li class="flex-shrink-0">
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'block px-3.5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider whitespace-nowrap transition-colors',
                link.highlight
                  ? 'text-zinc-950 bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400 shadow-emerald-glow'
                  : active
                    ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/30'
                    : 'text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800/60 border border-transparent',
              ]}
            >
              {link.name}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
