---
import WhatsAppButton from './WhatsAppButton.astro';
import { getEventWhatsAppUrl } from '../utils/whatsapp';
import { eventEnd, eventStart, formatDateRange, formatLongDate, formatTime, hasMeetup, type Evento } from '../utils/eventos';

interface Props {
  evento: Evento;
  /** Oculta la tarjeta desde el principio (la agenda decide luego en el navegador) */
  hidden?: boolean;
}

const { evento, hidden = false } = Astro.props;
const meetup = hasMeetup(evento);
const multiDay = eventEnd(evento) !== evento.date;
const dateLabel = multiDay ? formatDateRange(evento) : formatLongDate(evento.date);
const timeLabel = multiDay ? `desde las ${formatTime(evento.time)}` : formatTime(evento.time);
const attendUrl = getEventWhatsAppUrl(evento.title, `${dateLabel}, ${timeLabel}`);

---

<article
  class:list={['evento-card glass-card rounded-2xl overflow-hidden flex flex-col group h-full', { hidden }]}
  data-date={evento.date}
  data-end={eventEnd(evento)}
  data-start={eventStart(evento)}
  data-evento={JSON.stringify(evento)}
>
  <!-- Flyer -->
  <a
    href={evento.flyer}
    target="_blank"
    rel="noopener"
    data-flyer-zoom
    class="relative block overflow-hidden aspect-[4/5] bg-zinc-900"
    aria-label={`Ver flyer completo de ${evento.title}`}
  >
    <img
      src={evento.flyer}
      alt={`Flyer: ${evento.title}`}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </a>

  <!-- Content -->
  <div class="p-6 flex-grow flex flex-col justify-between gap-5">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
        {evento.type} · {dateLabel} · {timeLabel}
      </p>
      <h3 class="text-lg sm:text-xl font-bold text-zinc-100 tracking-tight leading-snug">
        {evento.title}
      </h3>
      {!meetup && (
        <p class="inline-flex mt-2 px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-zinc-800 text-zinc-300 border border-zinc-700">
          Evento del juego · sin quedada
        </p>
      )}
      {evento.bonus && (
        <p class="mt-3 px-3 py-2 rounded-lg text-sm font-bold bg-amber-500/10 text-amber-300 border border-amber-500/40">
          ★ Bonus: {evento.bonus}
        </p>
      )}
      <p class="text-sm text-zinc-400 mt-2 flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <span>{evento.location}</span>
      </p>
      {evento.description && (
        <p class="text-zinc-400 text-sm mt-3 leading-relaxed whitespace-pre-line">
          {evento.description}
        </p>
      )}
      {evento.link && (
        <a href={evento.link} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-400 hover:text-emerald-300">
          Ver detalles oficiales
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      )}
    </div>

    {meetup && <WhatsAppButton href={attendUrl} label="Quiero asistir" variant="primary" size="md" fullWidth />}
  </div>
</article>

<script>
  // Abre el flyer en grande dentro de la página, ajustado a la pantalla. Al abrir el SVG
  // directamente, Windows con la escala de pantalla al 125–150 % lo muestra cortado.
  let viewer: HTMLDialogElement | null = null;

  function openFlyer(src: string, alt: string) {
    if (!viewer) {
      viewer = document.createElement('dialog');
      viewer.className = 'flyer-viewer';
      viewer.innerHTML = `
        <img alt="" />
        <div class="flyer-viewer-actions">
          <button type="button" class="flyer-viewer-btn" data-download>Descargar</button>
          <button type="button" class="flyer-viewer-btn" data-close>Cerrar</button>
        </div>`;
      viewer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === viewer || target.closest('[data-close]')) viewer!.close();
        if (target.closest('[data-download]')) downloadPng(viewer!.querySelector('img')!);
      });
      document.body.append(viewer);
    }
    const img = viewer.querySelector('img')!;
    img.src = src;
    img.alt = alt;
    viewer.showModal();
  }

  /** Convierte el flyer (SVG o foto) a PNG para poder compartirlo en WhatsApp */
  async function downloadPng(img: HTMLImageElement) {
    const button = viewer!.querySelector<HTMLButtonElement>('[data-download]')!;
    button.disabled = true;
    try {
      const source = new Image();
      source.src = img.src;
      await source.decode();
      const canvas = document.createElement('canvas');
      canvas.width = source.naturalWidth || 1080;
      canvas.height = source.naturalHeight || 1350;
      canvas.getContext('2d')!.drawImage(source, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
      if (!blob) throw new Error('No se pudo crear la imagen');
      const name = (new URL(img.src).pathname.split('/').pop() || 'flyer').replace(/\.[a-z0-9]+$/i, '');
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `${name}.png`;
      link.click();
      setTimeout(() => URL.revokeObjectURL(link.href), 1000);
    } catch {
      // Si el navegador no puede convertirla, se descarga tal cual
      const link = document.createElement('a');
      link.href = img.src;
      link.download = '';
      link.click();
    } finally {
      button.disabled = false;
    }
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-flyer-zoom]');
    if (!link || e.ctrlKey || e.metaKey || e.shiftKey) return;
    e.preventDefault();
    openFlyer(link.href, link.querySelector('img')?.alt ?? 'Flyer');
  });
</script>

<style is:global>
  .flyer-viewer {
    max-width: 100vw;
    max-height: 100dvh;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: 16px;
    border: 0;
    background: rgba(3, 7, 18, 0.92);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .flyer-viewer[open] {
    display: flex;
  }
  .flyer-viewer::backdrop {
    background: transparent;
  }
  .flyer-viewer img {
    max-width: 100%;
    max-height: calc(100dvh - 96px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 16px;
  }
  .flyer-viewer-actions {
    display: flex;
    gap: 10px;
  }
  .flyer-viewer-btn {
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #030712;
    background: #34d399;
    cursor: pointer;
  }
  .flyer-viewer-btn[data-close] {
    color: #f4f4f5;
    background: #27272a;
  }
</style>
