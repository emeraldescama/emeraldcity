{
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cumple-correo",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/cumple-correo.js": {
      "includeFiles": "public/data/pokemon.json"
    },
    "api/admin.js": {
      "includeFiles": "public/data/pokemon.json"
    }
  }
}
