---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Haz amigos Pokémon con la comunidad | Emerald City"
  description="Códigos de amistad de los entrenadores de Emerald City. Cópialos y agrégalos en Pokémon GO."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-24">

    <!-- Encabezado -->
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 uppercase tracking-wider mb-4">
        Códigos de amistad
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-zinc-100 tracking-tight">
        Haz amigos Pokémon <span class="text-emerald-400">con la comunidad</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 mt-4 leading-relaxed">
        Copia el código de un entrenador y agrégalo en Pokémon GO. Más amigos significa más regalos, intercambios y bonos de ataque en las incursiones.
      </p>
    </div>

    <!-- Cómo agregar -->
    <ol class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8 text-sm text-zinc-300">
      <li class="glass-panel rounded-2xl p-4"><strong class="block text-amber-400 text-xs uppercase tracking-wider mb-1">Paso 1</strong>Toca <strong>Copiar</strong> en el entrenador que quieras.</li>
      <li class="glass-panel rounded-2xl p-4"><strong class="block text-amber-400 text-xs uppercase tracking-wider mb-1">Paso 2</strong>En Pokémon GO: tu avatar → <strong>Amigos</strong> → <strong>Agregar amigo</strong>.</li>
      <li class="glass-panel rounded-2xl p-4"><strong class="block text-amber-400 text-xs uppercase tracking-wider mb-1">Paso 3</strong>Pega el código y envía la solicitud.</li>
    </ol>

    <!-- Recomendar e intercambios -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 text-sm text-zinc-300">
      <p class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-4">
        <strong class="text-amber-300">Dale un like si el entrenador envía regalos seguido</strong> y así queda recomendado. Con 3 likes o más sale con la marca "Envía regalos".
      </p>
      <p class="rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-4">
        <strong class="text-emerald-300">¿Tienen un intercambio con suerte?</strong> Toca "Tengo intercambio con suerte" y se abre WhatsApp para coordinarlo con ese entrenador (o con la comunidad, que te ayuda a contactarlo).
      </p>
    </div>

    <!-- Buscador -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-6">
      <label for="buscar-amigo" class="sr-only">Buscar entrenador</label>
      <input
        id="buscar-amigo"
        type="search"
        placeholder="Buscar por nombre o ciudad"
        class="w-full sm:max-w-sm rounded-xl bg-zinc-900/90 border border-zinc-700 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-500/30 outline-none px-4 py-3 text-sm text-zinc-100 placeholder:text-zinc-500"
      />
      <label for="ordenar-amigos" class="sr-only">Ordenar</label>
      <select
        id="ordenar-amigos"
        class="rounded-xl bg-zinc-900/90 border border-zinc-700 focus:border-emerald-400 outline-none px-4 py-3 text-sm text-zinc-100"
      >
        <option value="recomendados">Más recomendados</option>
        <option value="recientes">Más recientes</option>
      </select>
      <p id="amigos-total" class="text-sm font-semibold text-zinc-400 sm:ml-auto" aria-live="polite"></p>
    </div>

    <!-- Lista -->
    <p id="amigos-cargando" class="text-center py-16 text-zinc-400">Cargando entrenadores…</p>
    <p id="amigos-error" class="hidden text-center py-16 text-zinc-400">No pudimos cargar la lista en este momento. Vuelve a intentarlo en unos minutos.</p>
    <p id="amigos-vacio" class="hidden text-center py-16 text-zinc-400">Todavía no hay entrenadores en la lista. ¡Sé el primero!</p>
    <ul id="amigos-lista" class="grid grid-cols-1 md:grid-cols-2 gap-4"></ul>

    <!-- Invitación -->
    <div class="mt-12 p-6 rounded-2xl border border-amber-500/40 bg-gradient-to-r from-amber-500/15 via-emerald-500/10 to-transparent flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <p class="text-lg font-black text-zinc-100">¿Quieres que te agreguen a ti?</p>
        <p class="text-sm text-zinc-300 mt-1">Regístrate en la comunidad y tu código aparecerá en esta lista.</p>
      </div>
      <a href="/unirse" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-sm font-black uppercase tracking-wider text-zinc-950 bg-gradient-to-r from-emerald-400 to-emerald-500 rounded-xl shadow-emerald-glow whitespace-nowrap">
        Quiero ser parte de la comunidad
      </a>
    </div>
  </div>
</Layout>

<script>
  interface Amigo {
    entrenador: string;
    codigo: string;
    ciudad: string;
    contacto: boolean;
    recomendaciones: number;
  }

  // Desde cuántas recomendaciones se muestra la marca "Envía regalos"
  const RECOMMENDED_FROM = 3;
  // Identificador que usaba la versión anterior: solo se envía para no perder sus likes
  const DEVICE_KEY = 'emerald-dispositivo';

  const $ = (id: string) => document.getElementById(id)!;
  let amigos: Amigo[] = [];
  // Likes de este visitante, según su cookie (el servidor decide, no el navegador)
  let votes = new Set<string>();

  const formatCode = (code: string) => code.replace(/(\d{4})(?=\d)/g, '$1 ');

  function legacyDeviceId(): string | undefined {
    try {
      return localStorage.getItem(DEVICE_KEY) ?? undefined;
    } catch {
      return undefined;
    }
  }

  async function copy(code: string, button: HTMLButtonElement) {
    try {
      await navigator.clipboard.writeText(code);
    } catch {
      // Respaldo para navegadores sin acceso al portapapeles
      const field = document.createElement('textarea');
      field.value = code;
      document.body.append(field);
      field.select();
      document.execCommand('copy');
      field.remove();
    }
    button.textContent = '¡Copiado!';
    button.dataset.copiado = 'true';
    setTimeout(() => {
      button.textContent = 'Copiar';
      button.dataset.copiado = 'false';
    }, 2000);
  }

  async function recommend(amigo: Amigo, button: HTMLButtonElement) {
    button.disabled = true;
    try {
      const res = await fetch('/api/amigos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accion: 'recomendar', codigo: amigo.codigo, dispositivo: legacyDeviceId() }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'No se pudo guardar. Inténtalo de nuevo.');
      amigo.recomendaciones = data.recomendaciones;
      if (data.recomendado) votes.add(amigo.codigo);
      else votes.delete(amigo.codigo);
      render();
    } catch (err) {
      button.disabled = false;
      button.title = (err as Error).message;
      alert((err as Error).message);
    }
  }

  const THUMB = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v11"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>';

  function card(amigo: Amigo, voted: boolean): HTMLLIElement {
    const item = document.createElement('li');
    item.className = 'glass-card rounded-2xl p-5 flex flex-col gap-4';

    const top = document.createElement('div');
    top.className = 'flex items-center gap-4';
    const avatar = document.createElement('span');
    avatar.className = 'w-12 h-12 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-lg font-black text-emerald-300 flex-shrink-0';
    avatar.textContent = amigo.entrenador.charAt(0).toUpperCase();

    const info = document.createElement('div');
    info.className = 'min-w-0 flex-1';
    const name = document.createElement('p');
    name.className = 'font-bold text-zinc-100 truncate flex items-center gap-2';
    const nameText = document.createElement('span');
    nameText.className = 'truncate';
    nameText.textContent = amigo.entrenador;
    name.append(nameText);
    if (amigo.recomendaciones >= RECOMMENDED_FROM) {
      const badge = document.createElement('span');
      badge.className = 'flex-shrink-0 px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-amber-400 text-zinc-950';
      badge.textContent = 'Envía regalos';
      name.append(badge);
    }
    const code = document.createElement('p');
    code.className = 'font-mono text-base tracking-widest text-amber-400';
    code.textContent = formatCode(amigo.codigo);
    const city = document.createElement('p');
    city.className = 'text-xs text-zinc-400 truncate';
    city.textContent = amigo.ciudad;
    info.append(name, code, city);

    const copyButton = document.createElement('button');
    copyButton.type = 'button';
    copyButton.className = 'copiar px-4 py-2.5 text-xs font-bold uppercase tracking-wider rounded-xl border transition-colors flex-shrink-0';
    copyButton.textContent = 'Copiar';
    copyButton.setAttribute('aria-label', `Copiar el código de ${amigo.entrenador}`);
    copyButton.addEventListener('click', () => copy(amigo.codigo, copyButton));
    top.append(avatar, info, copyButton);

    const bottom = document.createElement('div');
    bottom.className = 'flex flex-wrap items-center gap-2 pt-3 border-t border-zinc-800';
    const like = document.createElement('button');
    like.type = 'button';
    like.className = `recomendar inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold rounded-lg border transition-colors`;
    like.dataset.activo = String(voted);
    like.setAttribute('aria-pressed', String(voted));
    like.setAttribute('aria-label', `${voted ? 'Quitar like a' : 'Dar like a'} ${amigo.entrenador}: envía regalos`);
    like.innerHTML = `${THUMB}<span>${amigo.recomendaciones}</span>`;
    like.title = voted ? 'Ya le diste like. Toca para quitarlo.' : 'Dale like si te envía regalos seguido';
    like.addEventListener('click', () => recommend(amigo, like));
    bottom.append(like);

    // Si el entrenador no recibe mensajes, el enlace escribe a la comunidad para coordinarlo
    const trade = document.createElement('a');
    trade.href = `/api/contacto?codigo=${amigo.codigo}`;
    trade.target = '_blank';
    trade.rel = 'noopener';
    trade.className = 'inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold rounded-lg text-zinc-950 bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400';
    trade.textContent = 'Tengo intercambio con suerte';
    bottom.append(trade);

    item.append(top, bottom);
    return item;
  }

  function render() {
    const query = ($('buscar-amigo') as HTMLInputElement).value.trim().toLowerCase();
    const order = ($('ordenar-amigos') as HTMLSelectElement).value;
    const shown = amigos
      .filter((a) => !query || `${a.entrenador} ${a.ciudad}`.toLowerCase().includes(query))
      // La lista llega de la más reciente a la más antigua; "sort" mantiene ese orden en los empates
      .sort((a, b) => (order === 'recomendados' ? b.recomendaciones - a.recomendaciones : 0));

    $('amigos-lista').replaceChildren(...shown.map((amigo) => card(amigo, votes.has(amigo.codigo))));
    $('amigos-total').textContent = amigos.length
      ? `${shown.length} de ${amigos.length} entrenador${amigos.length === 1 ? '' : 'es'}`
      : '';
    $('amigos-vacio').classList.toggle('hidden', amigos.length > 0);
  }

  async function load() {
    try {
      const res = await fetch('/api/amigos');
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      amigos = data.amigos ?? [];
      votes = new Set(data.misVotos ?? []);
      render();
    } catch {
      $('amigos-error').classList.remove('hidden');
    } finally {
      $('amigos-cargando').classList.add('hidden');
    }
  }

  $('buscar-amigo').addEventListener('input', render);
  $('ordenar-amigos').addEventListener('change', render);
  load();
</script>

<style is:global>
  .copiar {
    color: #34d399;
    border-color: rgba(16, 185, 129, 0.4);
  }
  .copiar:hover {
    background: rgba(16, 185, 129, 0.12);
  }
  .recomendar {
    color: #a1a1aa;
    border-color: #3f3f46;
  }
  .recomendar:hover,
  .recomendar[data-activo='true'] {
    color: #fbbf24;
    border-color: rgba(251, 191, 36, 0.5);
    background: rgba(251, 191, 36, 0.1);
  }
  .copiar[data-copiado='true'] {
    color: #022c22;
    background: #34d399;
    border-color: #34d399;
  }
</style>
