---
import WhatsAppButton from './WhatsAppButton.astro';
import { getEventWhatsAppUrl } from '../utils/whatsapp';
import { eventEnd, eventStart, formatDateRange, formatLongDate, formatTime, hasMeetup, type Evento } from '../utils/eventos';

interface Props {
  evento: Evento;
  /** Oculta la tarjeta desde el principio (la agenda decide luego en el navegador) */
  hidden?: boolean;
}

const { evento, hidden = false } = Astro.props;
const meetup = hasMeetup(evento);
const multiDay = eventEnd(evento) !== evento.date;
const dateLabel = multiDay ? formatDateRange(evento) : formatLongDate(evento.date);
const timeLabel = multiDay ? `desde las ${formatTime(evento.time)}` : formatTime(evento.time);
const attendUrl = getEventWhatsAppUrl(evento.title, `${dateLabel}, ${timeLabel}`);

---

<article
  class:list={['evento-card glass-card rounded-2xl overflow-hidden flex flex-col group h-full', { hidden }]}
  data-date={evento.date}
  data-end={eventEnd(evento)}
  data-start={eventStart(evento)}
  data-evento={JSON.stringify(evento)}
>
  <!-- Flyer -->
  <a
    href={evento.flyer}
    target="_blank"
    rel="noopener"
    class="relative block overflow-hidden aspect-[4/5] bg-zinc-900"
    aria-label={`Ver flyer completo de ${evento.title}`}
  >
    <img
      src={evento.flyer}
      alt={`Flyer: ${evento.title}`}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </a>

  <!-- Content -->
  <div class="p-6 flex-grow flex flex-col justify-between gap-5">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
        {evento.type} · {dateLabel} · {timeLabel}
      </p>
      <h3 class="text-lg sm:text-xl font-bold text-zinc-100 tracking-tight leading-snug">
        {evento.title}
      </h3>
      {!meetup && (
        <p class="inline-flex mt-2 px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-zinc-800 text-zinc-300 border border-zinc-700">
          Evento del juego · sin quedada
        </p>
      )}
      <p class="text-sm text-zinc-400 mt-2 flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <span>{evento.location}</span>
      </p>
      {evento.description && (
        <p class="text-zinc-400 text-sm mt-3 leading-relaxed whitespace-pre-line">
          {evento.description}
        </p>
      )}
      {evento.link && (
        <a href={evento.link} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-400 hover:text-emerald-300">
          Ver detalles oficiales
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      )}
    </div>

    {meetup && <WhatsAppButton href={attendUrl} label="Quiero asistir" variant="primary" size="md" fullWidth />}
  </div>
</article>
